# =========================================================== local dev only
# On Vercel these are set in Project Settings > Environment Variables, not here.

PORT=8787
# '*' or a comma-separated list. Loopback origins are always allowed outside
# production, so a dev server on another port still works.
CORS_ORIGIN=*

# ================================================================= storage
# Unset locally: the app falls back to PGlite (real Postgres, WASM) on disk, so
# nothing has to be installed and the SQL is the same one production runs.
#
# On Vercel: add a Postgres store from the dashboard and it sets POSTGRES_URL
# for you. Leaving it unset in production makes the server refuse to boot,
# because the PGlite fallback writes to a filesystem a lambda does not keep.
# POSTGRES_URL=
LOCAL_DATA_DIR=./data/pg

# REQUIRED in production. Without it a per-boot secret is generated, and on
# serverless every cold start would silently invalidate every session.
# AUTH_SECRET=

# =============================================================== economics
# testnet2 UCT, 18 decimals. Amounts everywhere are BASE UNITS as strings.
COIN_ID=f581d30f593e4b369d684a4563b5246f07b1d265f7178a2c0a82b81f39c24dc0
COIN_DECIMALS=18
COIN_SYMBOL=UCT

FEE_BPS=500
MIN_PRICE_BASE=100000000000000000
MAX_PRICE_BASE=50000000000000000000
DEFAULT_PRICE_BASE=1000000000000000000
DEFAULT_REPLY_WINDOW_HOURS=72
DISPUTE_WINDOW_HOURS=24
MIN_REPLY_CHARS=80

# reply   = recipient earns by replying, silence refunds the sender  (default)
# silence = the inverted rule: silence pays the recipient
PAYOUT_POLICY=reply

# =================================================================== escrow
#
# WHERE SENDERS PAY. No default on purpose: an address the network cannot
# resolve makes every `send` intent fail with INVALID_RECIPIENT (4101), inside
# the wallet, where the error helps nobody.
#
#   npm run escrow:create
#
# creates the wallet, registers a nametag and writes both values below.
ESCROW_ADDRESS=

# simulated = state machine and ledger are real, no transfer is broadcast
# sphere    = the escrow wallet really settles on testnet2
PAYOUT_MODE=simulated
NETWORK=testnet2

# --- only read when PAYOUT_MODE=sphere ---
# BACK THIS UP. It is the only way to reach the float.
ESCROW_MNEMONIC=
ESCROW_DATA_DIR=./data/escrow-wallet
ESCROW_DEVICE_ID=paid-inbox-escrow

# Token custody and the mailbox. Sphere.init throws INVALID_CONFIG without it.
WALLET_API_URL=https://wallet-api.unicity.network

# testnet2 gateway key. Public, NOT a secret: it is published in the SDK docs.
AGGREGATOR_API_KEY=

# ==================================================================== demo
# A demo signature is a hash of the challenge and a PUBLIC key, so anyone can
# mint one for any account. The server refuses to boot in production with this
# on, and the UI hides the demo button when the server says it is off.
ALLOW_DEMO=1

# =============================================================== settlement
# Serverless has no timer, so a tick runs on API traffic at most this often.
SETTLEMENT_MIN_INTERVAL_MS=20000
# Optional bearer for /api/cron/settle. Vercel sets CRON_SECRET automatically.
# CRON_SECRET=
