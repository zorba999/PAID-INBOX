# ---------------------------------------------------------------- server
PORT=8787
CORS_ORIGIN=http://localhost:5174
DB_FILE=./data/paidinbox.db

# REQUIRED in production. Without it a per-boot secret is generated and every
# session dies on restart.
# AUTH_SECRET=

# ---------------------------------------------------------------- economics
# testnet2 UCT, 18 decimals. Amounts everywhere are BASE UNITS as strings.
COIN_ID=f581d30f593e4b369d684a4563b5246f07b1d265f7178a2c0a82b81f39c24dc0
COIN_DECIMALS=18
COIN_SYMBOL=UCT

FEE_BPS=500
MIN_PRICE_BASE=100000000000000000
MAX_PRICE_BASE=50000000000000000000
DEFAULT_PRICE_BASE=1000000000000000000
DEFAULT_REPLY_WINDOW_HOURS=72
DISPUTE_WINDOW_HOURS=24
MIN_REPLY_CHARS=80

# reply   = recipient earns by replying, silence refunds the sender  (default)
# silence = the inverted rule: silence pays the recipient
PAYOUT_POLICY=reply

# ---------------------------------------------------------------- escrow
#
# WHERE SENDERS PAY. There is no default on purpose: an address the network
# cannot resolve makes every `send` intent fail with INVALID_RECIPIENT (4101),
# and it fails inside the wallet where the message helps nobody.
#
# Register one with the CLI:  npm i -g @unicity-sphere/cli
#                             sphere wallet create escrow
#                             sphere init --network testnet --nametag my-escrow
# then put it here as @my-escrow (or use the DIRECT:// address).
#
# On PAYOUT_MODE=sphere the escrow wallet reports its own address and this can
# stay empty.
ESCROW_ADDRESS=

# simulated = state machine + ledger are real, no transfer is broadcast
# sphere    = the escrow wallet really settles on testnet2
PAYOUT_MODE=simulated
NETWORK=testnet2

# --- only read when PAYOUT_MODE=sphere ---
# Leave ESCROW_MNEMONIC empty on the first run and the server generates a
# wallet and prints the mnemonic once. Save it here or the float is stranded.
ESCROW_MNEMONIC=
ESCROW_DATA_DIR=./data/escrow-wallet
ESCROW_DEVICE_ID=paid-inbox-escrow

# Token custody and the mailbox. Sphere.init throws INVALID_CONFIG without it.
#   prod    = https://wallet-api.unicity.network
#   staging = https://wallet-api.staging.unicity.network
WALLET_API_URL=https://wallet-api.unicity.network

# testnet2 gateway key. Public, NOT a secret — it is published in the SDK docs.
# Empty is fine; set it to use your own rate limit instead of the shared one.
AGGREGATOR_API_KEY=

# ---------------------------------------------------------------- demo
# Accept demo-mode signatures. MUST be 0 in production — they are not
# cryptographic proof of key ownership.
ALLOW_DEMO=1

SETTLEMENT_INTERVAL_MS=15000
